{
  "name": "discord-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel bot:commands bot:start",
    "bot:commands": "bun run ./scripts/update-commands.ts",
    "bot:start": "bun run ./src/index.ts",
    "build": "NODE_ENV=production bun build --minify --compile ./src/index.ts --outfile=dist/bot --target=bun-linux-arm64",
    "format": "oxfmt",
    "lint": "oxlint"
  },
  "dependencies": {
    "discord.js": "14.26.5",
    "picocalc": "0.0.2",
    "websim": "0.1.0"
  },
  "devDependencies": {
    "@gameroman/config": "0.2.5",
    "@types/bun": "1.3.14",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "typescript": "7.0.2"
  }
}
